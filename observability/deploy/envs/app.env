MYSQL_HOST=db
MYSQL_USER=cct
MYSQL_DATABASE=cct
MYSQL_PORT=3306
MYSQL_PASSWORD_FILE=/run/secrets/db_password_file_secret
OTLP_TRACES_COLLECTOR_ENDPOINT=http://otel-collector:4318
OTLP_METRICS_COLLECTOR_ENDPOINT=http://otel-collector:4318
# interval after which new metrics are sent to the collector
OTEL_METRIC_EXPORT_INTERVAL=15000